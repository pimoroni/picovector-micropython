class spritesheet:
    """A grid over an image, numbering its cells so they can be addressed."""
    ROWS: int
    """Number the cells along each row in turn (default)."""
    COLUMNS: int
    """Number the cells down each column in turn."""
    @staticmethod
    def load(path_or_bytes, cols: float = 0, rows: float = 0) -> spritesheet:
        """Load a PNG, JPEG or GIF and return a sheet over it, which is what image.load(...).spritesheet(...) spells the long way. Omit the grid for a GIF: it already declared its frames. The image keeps whatever format the file was in, so a palettised one stays a byte a pixel."""
        ...
    @property
    def cols(self) -> int:
        """Grid columns (read-only)."""
        ...
    @property
    def rows(self) -> int:
        """Grid rows (read-only)."""
        ...
    @property
    def sprites(self) -> int:
        """Cells in the grid (read-only), and so the frame count of an animation - what you hand a tween as its endpoint. Always at least 1."""
        ...
    @property
    def direction(self) -> int:
        """How the grid numbers its cells: ROWS (default) counts along each row in turn, COLUMNS down each column - which is what makes a column of a tall sheet a contiguous run of numbers."""
        ...
    @direction.setter
    def direction(self, value: float) -> None: ...
    def sprite(self, x: float, y: float | None = None) -> image:
        """A cell of the grid, as a sub-image view sharing the sheet's pixels. sprite(n) takes a cell number, sprite(x, y) a column and a row. A negative number counts from the end, and anything outside the grid clamps into it, so no caller has to bounds-check first. A cell of a palettised sheet shares its colour table."""
        ...
    @property
    def timings(self) -> Any:
        """The per-frame durations a GIF declared, in milliseconds, or None for any other file (read-only). Reported rather than acted on: the sheet keeps no clock, so this is the information you need to build a tween that matches how the animation was authored - sum() it for the loop length, or walk it if the varying holds matter."""
        ...
    @property
    def source(self) -> Any:
        """The image these cells are carved from (read-only). A sheet keeps it alive, so holding the sheet is enough."""
        ...


