class tween:
    """Interpolate between two values over a normalised 0..1 progress, or over a
    duration in seconds, shaped by an easing curve.
    """
    LINEAR: int
    """Constant rate."""
    QUAD_IN: int
    """Quadratic ease-in."""
    QUAD_OUT: int
    """Quadratic ease-out."""
    QUAD_INOUT: int
    """Quadratic ease-in-out."""
    CUBIC_IN: int
    """Cubic ease-in."""
    CUBIC_OUT: int
    """Cubic ease-out."""
    CUBIC_INOUT: int
    """Cubic ease-in-out."""
    QUART_IN: int
    """Quartic ease-in."""
    QUART_OUT: int
    """Quartic ease-out."""
    QUART_INOUT: int
    """Quartic ease-in-out."""
    QUINT_IN: int
    """Quintic ease-in."""
    QUINT_OUT: int
    """Quintic ease-out."""
    QUINT_INOUT: int
    """Quintic ease-in-out."""
    SINE_IN: int
    """Sine ease-in."""
    SINE_OUT: int
    """Sine ease-out."""
    SINE_INOUT: int
    """Sine ease-in-out."""
    EXPO_IN: int
    """Exponential ease-in."""
    EXPO_OUT: int
    """Exponential ease-out."""
    EXPO_INOUT: int
    """Exponential ease-in-out."""
    CIRC_IN: int
    """Circular ease-in."""
    CIRC_OUT: int
    """Circular ease-out."""
    CIRC_INOUT: int
    """Circular ease-in-out."""
    BACK_IN: int
    """Back ease-in (overshoots the start)."""
    BACK_OUT: int
    """Back ease-out (overshoots the end)."""
    BACK_INOUT: int
    """Back ease-in-out (overshoots both ends)."""
    ELASTIC_IN: int
    """Elastic ease-in (overshoots)."""
    ELASTIC_OUT: int
    """Elastic ease-out (overshoots)."""
    ELASTIC_INOUT: int
    """Elastic ease-in-out (overshoots)."""
    BOUNCE_IN: int
    """Bounce ease-in."""
    BOUNCE_OUT: int
    """Bounce ease-out."""
    BOUNCE_INOUT: int
    """Bounce ease-in-out."""
    def __init__(self, start, end, duration: float = 1.0, easing: float = 0) -> None:
        """tween(start, end) interpolates over a normalised 0..1 progress; pass duration (seconds) to drive it with elapsed time instead. start/end set the value type: float, vec2, rect or mat3 (a mat3 blends as a decomposed translate/rotate/scale, discarding shear). easing is one of the tween.* curves (default LINEAR)."""
        ...
    def at(self, t: float):
        """Value at progress t: a normalised 0..1 fraction, or elapsed seconds if a duration was set. Progress clamps to the endpoints; returns the endpoint type (float, vec2, rect or mat3)."""
        ...
    def start(self, t: float | None = None):
        """Start (or restart) self-timing from the current clock and return self for chaining. Pass t to start from an explicit clock value. elapsed, now and done then track time since this call."""
        ...
    def stop(self):
        """Stop self-timing. elapsed holds at 0 and done reads False until the next start()."""
        ...
    @property
    def from_(self) -> Any:
        """Start endpoint (read-only)."""
        ...
    @property
    def to(self) -> Any:
        """End endpoint (read-only)."""
        ...
    @property
    def duration(self) -> Any:
        """Duration (read-only; 1.0 = normalised 0..1)."""
        ...
    @property
    def elapsed(self) -> Any:
        """Time since start() in the same unit as duration (0 before the first start())."""
        ...
    @property
    def now(self) -> Any:
        """Value at the current clock time (the endpoint type); needs start()."""
        ...
    @property
    def done(self) -> Any:
        """True once duration has elapsed since start(); False until started."""
        ...
    @property
    def running(self) -> Any:
        """True between start() and stop()."""
        ...


